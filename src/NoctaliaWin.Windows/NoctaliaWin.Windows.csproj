<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NoctaliaWin.Core\NoctaliaWin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Registry, System.Drawing and the tray's NotifyIcon come from the installed
         desktop runtime; no NuGet package is needed. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests exercise the decision logic behind these Win32 wrappers
         through their injected seams, not through the live registry or shell. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NoctaliaWin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
