<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NoctaliaWin.Core\NoctaliaWin.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Registry, System.Drawing and the tray's NotifyIcon come from the installed
         desktop runtime; no NuGet package is needed. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- The unit tests exercise the decision logic behind these Win32 wrappers
         through their injected seams, not through the live registry or shell. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>NoctaliaWin.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <PropertyGroup>
    <!-- The 22621 suffix is what lets this project call the system's media controls: the
         Windows.Media.Control projection ships inside the .NET SDK's Windows reference pack,
         so no NuGet package is added for it. It also matches the documented minimum, since
         this port requires Windows 11 22621 or newer. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

</Project>
